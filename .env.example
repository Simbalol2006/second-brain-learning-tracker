# Copy to .env and edit. Every value below is the default.

# Where the database, model cache and temporary audio files live (git-ignored).
DATA_DIR=data
LOG_LEVEL=INFO

# Embedding model (runs on CPU). Changing it later means re-ingesting into a fresh DATA_DIR.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Caption languages to accept, in order of preference (comma separated).
CAPTION_LANGUAGES=en

# Chunk size in words, and how many words consecutive chunks share.
CHUNK_WORDS=220
CHUNK_OVERLAP_WORDS=40

# Optional local transcription (needs: uv sync --extra whisper).
# WHISPER_DEVICE: cpu | cuda | auto. cuda needs the GPU setup from the README.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- LLM (Phase 2) ---
# LLM_PROVIDER: anthropic | ollama. All LLM calls go through this one setting.
LLM_PROVIDER=anthropic
# Leave LLM_MODEL empty to use the low-cost Anthropic default (claude-haiku-5-5).
# With LLM_PROVIDER=ollama it is required: the name of a model you pulled.
LLM_MODEL=
# Your key from the Anthropic Console. Never commit the real .env file.
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
# Rough budget for one prompt, and the output limit. Longer content is summarized in parts.
# For a small local model use about 4000 / 1024: Ollama's context window is set to the
# sum of the two, and a large context needs more VRAM.
LLM_MAX_INPUT_TOKENS=12000
LLM_MAX_OUTPUT_TOKENS=4096
