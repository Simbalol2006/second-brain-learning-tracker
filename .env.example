# Copy to .env and edit. Every value below is the default.

# Where the database, model cache and temporary audio files live (git-ignored).
DATA_DIR=data
LOG_LEVEL=INFO

# Embedding model (runs on CPU). Changing it later means re-ingesting into a fresh DATA_DIR.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Caption languages to accept, in order of preference (comma separated).
CAPTION_LANGUAGES=en

# Chunk size in words, and how many words consecutive chunks share.
CHUNK_WORDS=220
CHUNK_OVERLAP_WORDS=40

# Optional local transcription (needs: uv sync --extra whisper).
# WHISPER_DEVICE: cpu | cuda | auto. cuda needs the GPU setup from the README.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
